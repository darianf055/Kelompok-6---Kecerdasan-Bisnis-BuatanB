# Storage: buat Redis dari Vercel Marketplace (Upstash).
# Integrasi Vercel otomatis menambahkan KV_REST_API_URL dan KV_REST_API_TOKEN.
# (Kalau pakai Upstash langsung: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
#  Keduanya didukung oleh kode — tidak perlu diisi manual.)

# Sumopod Managed Payment — ambil di Dashboard → Managed Payment → Quick Start / Settings
# Sandbox: https://api-pay-sandbox.sumopod.com/api/v1
# Live:    https://api-pay.sumopod.com/api/v1  (cek lagi di dashboard saat sudah live)
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://api-pay-sandbox.sumopod.com/api/v1

# Webhook → Settings → Webhook
SUMOPOD_WEBHOOK_TOKEN=
SUMOPOD_WEBHOOK_SECRET=

# URL public hasil deploy, mis. https://timlog-xxx.vercel.app
SITE_URL=
